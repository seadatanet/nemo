<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>

<product name="NEMO" uid="NEMO" id="fr.ifremer.nemo.productnemo" application="fr.ifremer.nemo.nemoid" useFeatures="false" includeLaunchers="true">

   <aboutInfo>
      <image path="/NEMO_product/nemoAbout.gif"/>
      <text>
         %aboutText
      </text>
   </aboutInfo>

   <configIni use="default">
   </configIni>

   <launcherArgs>
   </launcherArgs>

   <windowImages i16="/NEMO_product/nemo16.gif" i32="/NEMO_product/nemo32.gif"/>

   <splash
      location="fr.ifremer.nemo" />
   <launcher name="nemo">
      <solaris/>
      <win useIco="false">
         <bmp/>
      </win>
   </launcher>

   <vm>
   </vm>

   <plugins>
      <plugin id="com.ibm.icu"/>
