<!-- Generation de l'installeur de la structure d'accueil Daurade -->
<project name="com.shom.daurade.build" default="build">
	<!--sets the path of the properties file-->
	<property name="pdeBuildPluginVersion" value="3.6.1.R36x_v20100823" />
	<property name="equinoxLauncherPluginVersion" value="1.1.0.v20100507" />

	<target name="init" description="Copie des sources">
		<!-- ### Ugly hack pour eviter les antislashs dans repertoire courant ###  -->
		<path id="pathbuildDirectory">
			<pathelement location="/${basedir}"/>
		</path>
		<pathconvert targetos="unix" property="winbuildDirectory" refid="pathbuildDirectory"/>
		<echo> Build directory ${basedir} ou ${winbuildDirectory} </echo>
		
		<replaceregexp file="build.properties"
					match="buildDirectory=.*"
					replace="buildDirectory=${winbuildDirectory}" 
					byline="true" />
		<!-- ### -->
		
		<property file="build.properties" />
		<!--
		<mkdir dir="${buildDirectory}/plugins" />
		<mkdir dir="${buildDirectory}/features" />
		-->
	</target>

	<target name="pde-build" description="Eclipse PDE Build">
		<java classname="org.eclipse.equinox.launcher.Main" fork="true" failonerror="true">
			<arg value="-application" />
			<arg value="org.eclipse.ant.core.antRunner" />
			<arg value="-buildfile" />
			<arg value="${baseLocation}/plugins/org.eclipse.pde.build_${pdeBuildPluginVersion}/scripts/productBuild/productBuild.xml" />
			<arg value="-Dtimestamp=${timestamp}" />
			<classpath>
				<pathelement location="${baseLocation}/plugins/org.eclipse.equinox.launcher_${equinoxLauncherPluginVersion}.jar" />
			</classpath>
		</java>

		<!-- Ajout des fichiers necessaire a l'application-->
<!--		<copy todir="${buildDirectory}/tmp/${archivePrefix}">
			<fileset dir="plugins/com.shom.daurade.sa/">
				<include name="conf/**" />
			</fileset>
		</copy>   -->
	</target>

	<target name="installer" description="Make installer with IzPack">

		<mkdir dir="${buildDirectory}/Nemo_IzPack/src/win32.win32.x86"/>
		<unzip src="${buildDirectory}/Nemo-win32.win32.x86.zip" dest="${buildDirectory}/Nemo_IzPack/src/win32.win32.x86"/>
		<mkdir dir="${buildDirectory}/Nemo_IzPack/src/win32.win32.x86_64"/>
		<unzip src="${buildDirectory}/Nemo-win32.win32.x86_64.zip" dest="${buildDirectory}/Nemo_IzPack/src/win32.win32.x86_64"/>
		<mkdir dir="${buildDirectory}/Nemo_IzPack/src/linux.gtk.x86"/>
		<unzip src="${buildDirectory}/Nemo-linux.gtk.x86.zip" dest="${buildDirectory}/Nemo_IzPack/src/linux.gtk.x86"/>
		<mkdir dir="${buildDirectory}/Nemo_IzPack/src/linux.gtk.x86_64"/>
		<unzip src="${buildDirectory}/Nemo-linux.gtk.x86_64.zip" dest="${buildDirectory}/Nemo_IzPack/src/linux.gtk.x86_64"/>
		<mkdir dir="${buildDirectory}/Nemo_IzPack/src/solaris.gtk.sparc"/>
		<unzip src="${buildDirectory}/Nemo-solaris.gtk.sparc.zip" dest="${buildDirectory}/Nemo_IzPack/src/solaris.gtk.sparc"/>
		
		<ant dir="${buildDirectory}/Nemo_IzPack/hudson" inheritAll="false"/> 
		
	</target>
	
	<!--This target defines the run-order of the targets-->
	<target name="build" depends="init, pde-build, installer" />
</project>
