<!-- Use this file to deploy some handlers/chains and services      -->
<!-- Two ways to do this:                                           -->
<!--   java org.apache.axis.client.AdminClient deploy.wsdd          -->
<!--      after the axis server is running                          -->
<!-- or                                                             -->
<!--   java org.apache.axis.utils.Admin client|server deploy.wsdd   -->
<!--      from the same directory that the Axis engine runs         -->

<deployment
    xmlns="http://xml.apache.org/axis/wsdd/"
    xmlns:java="http://xml.apache.org/axis/wsdd/providers/java">

  <!-- Services from NautilusSurveyWSService WSDL service -->

  <service name="NAUTILUS" provider="java:RPC" style="rpc" use="encoded">
      <parameter name="wsdlTargetNamespace" value="nautilus"/>
      <parameter name="wsdlServiceElement" value="NautilusSurveyWSService"/>
      <parameter name="schemaUnqualified" value="nautilus"/>
      <parameter name="wsdlServicePort" value="NAUTILUS"/>
      <parameter name="className" value="fr.ifremer.nautilus.metadata.NautilusSurveyWSImpl"/>
      <parameter name="wsdlPortType" value="NautilusSurveyWS"/>
      <parameter name="typeMappingVersion" value="1.2"/>
      <operation name="getSurvey" qname="operNS:getSurvey" xmlns:operNS="nautilus" returnQName="getSurveyReturn" returnType="rtns:WSSurvey" xmlns:rtns="nautilus" soapAction="" >
        <parameter qname="in0" type="tns:string" xmlns:tns="http://www.w3.org/2001/XMLSchema"/>
      </operation>
      <parameter name="allowedMethods" value="getSurvey"/>

      <typeMapping
        xmlns:ns="nautilus"
        qname="ns:WSCollectedData"
        type="java:fr.ifremer.nautilus.metadata.WSCollectedData"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <arrayMapping
        xmlns:ns="nautilus"
        qname="ns:ArrayOfWSCollectedData"
        type="java:fr.ifremer.nautilus.metadata.WSCollectedData[]"
        innerType="cmp-ns:WSCollectedData" xmlns:cmp-ns="nautilus"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <typeMapping
        xmlns:ns="nautilus"
        qname="ns:WSSurvey"
        type="java:fr.ifremer.nautilus.metadata.WSSurvey"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
  </service>
</deployment>
