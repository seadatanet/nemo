<!-- Use this file to deploy some handlers/chains and services      -->
<!-- Two ways to do this:                                           -->
<!--   java org.apache.axis.client.AdminClient deploy.wsdd          -->
<!--      after the axis server is running                          -->
<!-- or                                                             -->
<!--   java org.apache.axis.utils.Admin client|server deploy.wsdd   -->
<!--      from the same directory that the Axis engine runs         -->

<deployment
    xmlns="http://xml.apache.org/axis/wsdd/"
    xmlns:java="http://xml.apache.org/axis/wsdd/providers/java">

  <!-- Services from NemoWSService WSDL service -->

  <service name="NEMO" provider="java:RPC" style="rpc" use="encoded">
      <parameter name="wsdlTargetNamespace" value="nemo"/>
      <parameter name="wsdlServiceElement" value="NemoWSService"/>
      <parameter name="schemaUnqualified" value="nemo"/>
      <parameter name="wsdlServicePort" value="NEMO"/>
      <parameter name="className" value="fr.ifremer.nemo.ws.NemoWSImpl"/>
      <parameter name="wsdlPortType" value="NemoWS"/>
      <parameter name="typeMappingVersion" value="1.2"/>
      <operation name="getParameters" qname="operNS:getParameters" xmlns:operNS="nemo" returnQName="getParametersReturn" returnType="rtns:ArrayOfWSParameter" xmlns:rtns="nemo" returnItemType="tns2:WSParameter" xmlns:tns2="nemo" soapAction="" >
      </operation>
      <operation name="getCountries" qname="operNS:getCountries" xmlns:operNS="nemo" returnQName="getCountriesReturn" returnType="rtns:ArrayOfWSCountry" xmlns:rtns="nemo" returnItemType="tns2:WSCountry" xmlns:tns2="nemo" soapAction="" >
      </operation>
      <operation name="getDataCentres" qname="operNS:getDataCentres" xmlns:operNS="nemo" returnQName="getDataCentresReturn" returnType="rtns:ArrayOfWSDataCentre" xmlns:rtns="nemo" returnItemType="tns2:WSDataCentre" xmlns:tns2="nemo" soapAction="" >
      </operation>
      <operation name="getDataTypes" qname="operNS:getDataTypes" xmlns:operNS="nemo" returnQName="getDataTypesReturn" returnType="rtns:ArrayOfWSDataType" xmlns:rtns="nemo" returnItemType="tns2:WSDataType" xmlns:tns2="nemo" soapAction="" >
      </operation>
      <operation name="getRegions" qname="operNS:getRegions" xmlns:operNS="nemo" returnQName="getRegionsReturn" returnType="rtns:ArrayOfWSRegion" xmlns:rtns="nemo" returnItemType="tns2:WSRegion" xmlns:tns2="nemo" soapAction="" >
      </operation>
      <operation name="getShips" qname="operNS:getShips" xmlns:operNS="nemo" returnQName="getShipsReturn" returnType="rtns:ArrayOfWSShip" xmlns:rtns="nemo" returnItemType="tns2:WSShip" xmlns:tns2="nemo" soapAction="" >
      </operation>
      <operation name="getSurveyList" qname="operNS:getSurveyList" xmlns:operNS="nemo" returnQName="getSurveyListReturn" returnType="rtns:ArrayOfWSSurveyDescription" xmlns:rtns="nemo" returnItemType="tns2:WSSurveyDescription" xmlns:tns2="nemo" soapAction="" >
      </operation>
      <parameter name="allowedMethods" value="getCountries getShips getRegions getSurveyList getParameters getDataTypes getDataCentres"/>

      <arrayMapping
        xmlns:ns="nemo"
        qname="ns:ArrayOfWSSurveyDescription"
        type="java:fr.ifremer.nemo.ws.WSSurveyDescription[]"
        innerType="cmp-ns:WSSurveyDescription" xmlns:cmp-ns="nemo"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <typeMapping
        xmlns:ns="nemo"
        qname="ns:WSDataType"
        type="java:fr.ifremer.nemo.ws.WSDataType"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <arrayMapping
        xmlns:ns="nemo"
        qname="ns:ArrayOfWSCountry"
        type="java:fr.ifremer.nemo.ws.WSCountry[]"
        innerType="cmp-ns:WSCountry" xmlns:cmp-ns="nemo"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <typeMapping
        xmlns:ns="nemo"
        qname="ns:WSParameter"
        type="java:fr.ifremer.nemo.ws.WSParameter"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <arrayMapping
        xmlns:ns="nemo"
        qname="ns:ArrayOfWSDataType"
        type="java:fr.ifremer.nemo.ws.WSDataType[]"
        innerType="cmp-ns:WSDataType" xmlns:cmp-ns="nemo"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <arrayMapping
        xmlns:ns="nemo"
        qname="ns:ArrayOfWSRegion"
        type="java:fr.ifremer.nemo.ws.WSRegion[]"
        innerType="cmp-ns:WSRegion" xmlns:cmp-ns="nemo"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <typeMapping
        xmlns:ns="nemo"
        qname="ns:WSRegion"
        type="java:fr.ifremer.nemo.ws.WSRegion"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <typeMapping
        xmlns:ns="nemo"
        qname="ns:WSShip"
        type="java:fr.ifremer.nemo.ws.WSShip"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <typeMapping
        xmlns:ns="nemo"
        qname="ns:WSDataCentre"
        type="java:fr.ifremer.nemo.ws.WSDataCentre"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <typeMapping
        xmlns:ns="nemo"
        qname="ns:WSSurveyDescription"
        type="java:fr.ifremer.nemo.ws.WSSurveyDescription"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <typeMapping
        xmlns:ns="nemo"
        qname="ns:WSCountry"
        type="java:fr.ifremer.nemo.ws.WSCountry"
        serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <arrayMapping
        xmlns:ns="nemo"
        qname="ns:ArrayOfWSShip"
        type="java:fr.ifremer.nemo.ws.WSShip[]"
        innerType="cmp-ns:WSShip" xmlns:cmp-ns="nemo"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <arrayMapping
        xmlns:ns="nemo"
        qname="ns:ArrayOfWSParameter"
        type="java:fr.ifremer.nemo.ws.WSParameter[]"
        innerType="cmp-ns:WSParameter" xmlns:cmp-ns="nemo"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
      <arrayMapping
        xmlns:ns="nemo"
        qname="ns:ArrayOfWSDataCentre"
        type="java:fr.ifremer.nemo.ws.WSDataCentre[]"
        innerType="cmp-ns:WSDataCentre" xmlns:cmp-ns="nemo"
        encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
      />
  </service>
</deployment>
